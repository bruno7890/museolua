{
  "name": "museo-de-lua",
  "version": "0.1.0",
  "private": true,
  "description": "Museo 3D personal dedicado a Lua. Adaptado de lrusso/3DArtMuseum (GPL-3.0).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:subdir": "playwright test --config=playwright.subdir.config.ts",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "check:budget": "node --experimental-strip-types scripts/check-budget.ts",
    "hash:key": "node --experimental-strip-types scripts/hash-access-key.ts",
    "media:demo": "node --experimental-strip-types scripts/generate-demo-media.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "axe-core": "4.14.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
