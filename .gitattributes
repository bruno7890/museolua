* text=auto eol=lf

# Scripts de Windows: necesitan CRLF para ejecutarse en cmd.exe y PowerShell.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Medios: binarios, sin conversiones de fin de línea.
*.png binary
*.jpg binary
*.mp3 binary
*.mp4 binary
*.vtt text eol=lf
*.svg text eol=lf
